# =============================================================================
# AWE Platform — Self-Host Environment Configuration
#
# Copy this file to `.env` and fill in the values for your environment.
# Run: cp .env.example .env
#
# All variables are consumed by docker-compose.yml.
# NO rebuild is needed when you change values — just restart the containers.
# =============================================================================

# GLOBAL ENVIRONMENT: develop | staging | production
ASPNETCORE_ENVIRONMENT=develop

# ─────────────────────────────────────────────────────────────────────────────
# GHCR IMAGE REGISTRY
# The registry/org where the AWE Docker images are published.
# Example: ghcr.io/my-org
# ─────────────────────────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# PORT MAPPING (Host-side ports)
# ─────────────────────────────────────────────────────────────────────────────
API_GATEWAY_HTTP_PORT=8080
API_GATEWAY_HTTPS_PORT=8443
FRONTEND_PORT=80

RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

POSTGRES_PORT=15432
REDIS_PORT=6389
REDISINSIGHT_PORT=5541
MINIO_PORT=9000
MINIO_MANAGEMENT_PORT=9001

KEYCLOAK_PORT=8081
DASHBOARD_UI_PORT=19888
DASHBOARD_OTLP_PORT=19889

# ─────────────────────────────────────────────────────────────────────────────
# POSTGRESQL
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_IMAGE_TAG=18.1-alpine
POSTGRES_USER=awe_user
POSTGRES_PASSWORD=change_me

# ─────────────────────────────────────────────────────────────────────────────
# RABBITMQ
# ─────────────────────────────────────────────────────────────────────────────
RABBITMQ_IMAGE_TAG=4.0-management
RABBITMQ_DEFAULT_USER=awe-service
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_DEFAULT_VHOST=awe-system

# Connection details used by .NET services (internal Docker DNS)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=awe-service
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=awe-system

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_IMAGE_TAG=8.6.1-trixie
REDIS_PASSWORD=change_me

# ─────────────────────────────────────────────────────────────────────────────
# MINIO OBJECT STORAGE
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=awe-service
MINIO_ROOT_PASSWORD=change_me

# ─────────────────────────────────────────────────────────────────────────────
# MASSTRANSIT TUNING
# ─────────────────────────────────────────────────────────────────────────────
MT_RETRY_COUNT=5
MT_RETRY_INTERVAL_SECONDS=10
MT_PREFETCH_COUNT=16
MT_CONCURRENT_MESSAGE_LIMIT=8

# ─────────────────────────────────────────────────────────────────────────────
# WORKFLOW ENGINE
# ─────────────────────────────────────────────────────────────────────────────
WORKFLOW_ENGINE_NAME=AWE
WORKFLOW_ENGINE_INSTANCE_ID=self-host-01

# ─────────────────────────────────────────────────────────────────────────────
# KEYCLOAK
# ─────────────────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# Internal URL used by the Backend (api-gateway) for JWT validation.
# Must use Docker-internal DNS — NOT localhost.
KEYCLOAK_INTERNAL_AUTHORITY=http://awe-keycloak:8080/realms/awe-auth

# Public URL used by the Frontend browser to redirect to Keycloak login.
# Change localhost:8081 to your server IP/domain when deploying on a real server.
OIDC_AUTHORITY=http://localhost:8081/realms/awe-auth

# ─────────────────────────────────────────────────────────────────────────────
# ASPIRE DASHBOARD SSO (separate Keycloak client — NOT the same as the FE client)
# ─────────────────────────────────────────────────────────────────────────────
ASPIRE_OIDC_CLIENT_ID=aspire-dashboard
# Copy the client secret from Keycloak → Clients → aspire-dashboard → Credentials
OIDC_CLIENT_SECRET=change_me

# ─────────────────────────────────────────────────────────────────────────────
# ASPIRE DASHBOARD TELEMETRY
# ─────────────────────────────────────────────────────────────────────────────
# Generate a strong random string: openssl rand -hex 32
DASHBOARD_OTLP_TOKEN=change_me

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND RUNTIME CONFIG
# Injected into the running container at startup — no rebuild required.
# ─────────────────────────────────────────────────────────────────────────────

# /api and /hubs/* are proxied by the Nginx inside the frontend container
FRONTEND_API_URL=/api
FRONTEND_SIGNALR_URL=/hubs/workflow

# Keycloak public client for the React frontend (NOT the Aspire Dashboard client)
OIDC_FE_CLIENT_ID=awe-fe

# Redirect URIs must match "Valid Redirect URIs" configured in Keycloak
OIDC_REDIRECT_URI=http://localhost/
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost/

OIDC_SCOPE=openid profile email roles

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_METRICS=true
ENABLE_HEALTHCHECK=true
